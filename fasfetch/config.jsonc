{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " » ",
    "color": {
      "keys": "yellow"
    }
  },
  "logo": {
    "source": "/Users/armando/.config/fastfetch/megaman.txt",
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
      "1": "blue"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "┌────────────Software────────────┐"
    },
    {
      "type": "os",
      "key": "│ OS          ",
      "format": "{3} ({10})"
    },
    {
      "type": "host",
      "key": "│ Host        "
    },
    {
      "type": "kernel",
      "key": "│ Kernel      "
    },
    {
      "type": "packages",
      "key": "│ Packages    "
    },
    {
      "type": "shell",
      "key": "│ Shell       "
    },
    {
      "type": "terminal",
      "key": "│ Terminal  󰀻  "
    },
    {
      "type": "wm",
      "key": "│ WM          "
    },
    {
      "type": "font",
      "key": "│ Font        "
    },
    {
      "type": "separator",
      "string": "└────────────────────────────────┘"
    },
    "break",
    {
      "type": "separator",
      "string": "┌────────────Hardware────────────┐"
    },
    {
      "type": "cpu",
      "key": "│ CPU         "
    },
    {
      "type": "gpu",
      "key": "│ GPU         "
    },
    {
      "type": "memory",
      "key": "│ Memory      "
    },
    {
      "type": "battery",
      "key": "│ Battery     "
    },
    {
      "type": "separator",
      "string": "└────────────────────────────────┘"
    },
    "break",
    {
    "type": "custom",
    "format": "       {#33}󰮯  {#31}󰊠  {#32}󰊠  {#34}󰊠  {#35}󰊠  {#36}󰊠"
    }  
  ]
}
